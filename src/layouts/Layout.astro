---
import BaseHead from "@/components/fundations/head/BaseHead.astro";
import Navigation from "@/components/sections/Navigation.astro";
import Footer from "@/components/sections/Footer.astro";
import Analytics from '@vercel/analytics/astro'
import type { Props as SeoProps } from "@/components/fundations/head/Seo.astro";

export interface Props extends SeoProps {}

const props = Astro.props;
---

<!doctype html>
<html lang="en-GB" class="dark">
  <head>
    <BaseHead {...props} />
    <Analytics />
  </head>
  <body class="bg-white dark:bg-base-950">
    <Navigation />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
