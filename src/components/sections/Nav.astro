---
import Container from "@/components/ui/Container.astro";

const links = [
  { href: "/#work", text: "Work" },
  { href: "/#approach", text: "Approach" },
  { href: "/#pricing", text: "Pricing" },
  { href: "/blog", text: "Blog" },
  { href: "/contact-us", text: "Contact" },
];
---

<header class="border-b border-line sticky top-0 z-10 w-full bg-paper">
  <Container class="flex items-center justify-between py-5">
    <a href="/" class="font-display text-xl font-semibold tracking-tight text-ink">
      Worm Studio
    </a>
    <nav class="hidden md:flex items-center gap-8">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="text-sm text-ink-muted hover:text-gold-deep transition-colors"
          >
            {link.text}
          </a>
        ))
      }
    </nav>

    <button
      id="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      class="md:hidden relative w-8 h-8 flex flex-col justify-center items-center gap-1.5"
    >
      <span class="sr-only">Toggle menu</span>
      <span id="nav-bar-1" class="block w-6 h-px bg-ink transition-transform"></span>
      <span id="nav-bar-2" class="block w-6 h-px bg-ink transition-opacity"></span>
      <span id="nav-bar-3" class="block w-6 h-px bg-ink transition-transform"></span>
    </button>
  </Container>

  <nav
    id="mobile-nav"
    class="hidden md:hidden absolute top-full left-0 right-0 bg-paper border-b border-line z-50"
  >
    <Container class="flex flex-col py-2">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="py-3 border-b border-line last:border-b-0 text-ink text-lg font-display"
          >
            {link.text}
          </a>
        ))
      }
    </Container>
  </nav>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const menu = document.getElementById("mobile-nav");
  const bar1 = document.getElementById("nav-bar-1");
  const bar2 = document.getElementById("nav-bar-2");
  const bar3 = document.getElementById("nav-bar-3");

  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.contains("hidden") === false;
    menu?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!isOpen));
    bar1?.classList.toggle("rotate-45");
    bar1?.classList.toggle("translate-y-[7px]");
    bar2?.classList.toggle("opacity-0");
    bar3?.classList.toggle("-rotate-45");
    bar3?.classList.toggle("-translate-y-[7px]");
  });

  // Close the menu after tapping a link, so it doesn't stay open on navigation
  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.classList.add("hidden");
      toggle?.setAttribute("aria-expanded", "false");
      bar1?.classList.remove("rotate-45", "translate-y-[7px]");
      bar2?.classList.remove("opacity-0");
      bar3?.classList.remove("-rotate-45", "-translate-y-[7px]");
    });
  });
</script>

