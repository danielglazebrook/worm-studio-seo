---
import Container from "@/components/ui/Container.astro";

const steps = [
  { title: "Audit", timing: "Week 1", description: "We assess your current visibility across traditional search and AI search - where you rank, where you're cited, and where you're invisible." },
  { title: "Strategy", timing: "Week 1-2", description: "A prioritised plan: what to fix technically, what content needs restructuring, and where the highest-impact AI-visibility gaps are." },
  { title: "Implementation", timing: "Ongoing", description: "Technical SEO fixes, structured data, content restructuring, and GEO/AEO optimisation - built and shipped, not just recommended." },
  { title: "Monitor & Adapt", timing: "Ongoing", description: "AI search is moving fast. We track how your visibility shifts and adjust the strategy as the landscape changes." },
];
---

<section id="process" class="py-16 md:py-24 border-t border-line">
  <Container grid>
    <div class="col-span-12 md:col-span-3">
      <h2 class="font-display text-2xl font-semibold text-ink">How we work</h2>
    </div>
    <div class="col-span-12 md:col-span-9 grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-10">
      {
        steps.map((step, i) => (
          <div>
            <span class="font-display text-4xl text-gold">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="font-display text-lg font-medium text-ink mt-2">{step.title}</h3>
            <p class="text-sm text-ink-muted mt-1">{step.timing}</p>
            <p class="text-ink-muted mt-3">{step.description}</p>
          </div>
        ))
      }
    </div>
  </Container>
</section>
