---
import { getCollection } from "astro:content";
// Foundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import ArrowRight from "@/components/fundations/icons/ArrowRight.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<section class="scroll-mt-32" id="blog">
  <Wrapper variant="standard" class="py-12 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start">
      <div class="lg:col-start-2">
        <Text tag="p" variant="textSM" class="text-base-600 dark:text-base-300">
          Blog
          <br />
          Latest writing
        </Text>
      </div>
      <Text
        tag="h2"
        variant="textXL"
        class="font-semibold leading-snug tracking-tighter lg:col-span-2 text-base-900 dark:text-white"
      >
        Blog
      </Text>
    </div>

    {
      posts.length > 0 ? (
        <div class="flex flex-col gap-12 mt-12">
          {posts.map((post) => (
            <article class="py-12 border-t border-base-200 dark:border-base-800">
              <div class="grid grid-cols-1 gap-4 lg:grid-cols-4 items-start">
                <Text tag="p" variant="textXS" class="text-base-600 dark:text-base-300 uppercase">
                  {post.data.pubDate.toLocaleDateString("en-GB", { year: "numeric", month: "short" })} — {post.data.category}
                </Text>
                <Text tag="h3" variant="textLG" class="text-base-900 dark:text-white leading-tight font-semibold">
                  {post.data.title}
                </Text>
                <Text tag="p" variant="textSM" class="text-base-600 dark:text-base-300">
                  {post.data.description}
                </Text>
                <a
                  href={`/blog/${post.slug}`}
                  class="lg:ml-auto text-base-900 dark:text-white hover:text-accent-600 transition"
                >
                  <span class="sr-only">Read {post.data.title}</span>
                  <ArrowRight size="sm" />
                </a>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <div class="mt-12 py-12 border-t border-base-200 dark:border-base-800">
          <Text tag="p" variant="textLG" class="text-base-600 dark:text-base-300 max-w-xl">
            First post is on its way &mdash; we're documenting our own
            AI-search visibility experiment as it happens.
          </Text>
        </div>
      )
    }
  </Wrapper>
</section>
