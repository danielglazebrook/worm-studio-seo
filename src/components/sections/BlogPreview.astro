---
import { getCollection } from "astro:content";
import Container from "@/components/ui/Container.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---

<section id="blog" class="scroll-mt-24 py-16 md:py-24 border-t border-line">
  <Container grid>
    <div class="col-span-12 md:col-span-3">
      <h2 class="font-display text-2xl font-semibold text-ink">Blog</h2>
    </div>
    <div class="col-span-12 md:col-span-9">
      {
        posts.length > 0 ? (
          <div class="flex flex-col">
            {posts.map((post) => (
              <a href={`/blog/${post.slug}`} class="group grid grid-cols-1 md:grid-cols-12 gap-x-6 py-6 border-b border-line first:pt-0">
                <p class="md:col-span-3 text-xs text-ink-muted">
                  {post.data.pubDate.toLocaleDateString("en-GB", { year: "numeric", month: "short" })}
                </p>
                <h3 class="md:col-span-6 font-display text-lg font-medium text-ink group-hover:text-gold-deep transition-colors">
                  {post.data.title}
                </h3>
                <p class="md:col-span-3 text-sm text-ink-muted mt-2 md:mt-0">{post.data.category}</p>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-lg text-ink-muted max-w-prose">
            First post is on its way - we're documenting our own AI-search visibility experiment as it happens.
          </p>
        )
      }
    </div>
  </Container>
</section>
