---
// Foundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import ArrowRight from "@/components/fundations/icons/ArrowRight.astro";
---

<section>
  <Wrapper variant="standard" class="pb-8 pt-40 lg:pt-80">
    <div class="grid grid-cols-1 lg:grid-cols-4 items-start gap-y-8">
      <Text
        tag="h1"
        variant="displayLG"
        class="font-semibold leading-snug text-left tracking-tighter lg:col-span-2 text-base-900 dark:text-white lg:col-start-3"
      >
        SEO, GEO & AEO done properly, never automated.
      </Text>
      <Text
        tag="p"
        variant="textLG"
        class="lg:col-start-3 dark:text-white lg:col-span-2"
      >
        We're a search visibility agency. Search isn't just Google anymore
        &mdash; people are asking ChatGPT and Perplexity for recommendations
        too, and we get you found in both. The difference: we don't chase
        that with generic, templated content stuffed for algorithms. Every
        piece is written and structured properly first, because genuinely
        good content is what search engines and AI models actually favour
        &mdash; then we handle the technical side (schema, structure,
        performance) that makes sure it gets picked up.
      </Text>
      <div class="lg:col-start-3 lg:col-span-2 flex gap-4 mt-4">
        <Button isLink variant="default" size="md" href="#work">
          See how we work
        </Button>
        <Button isLink variant="muted" size="md" gap="xs" href="/contact-us">
          Get in touch
          <ArrowRight slot="right-icon" size="sm" />
        </Button>
      </div>
    </div>
  </Wrapper>
</section>
