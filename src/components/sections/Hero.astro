---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
---

<section class="relative overflow-hidden">
  <!-- Signature device: visible grid guides, only here, quiet everywhere else -->
  <div class="absolute inset-0 pointer-events-none">
    <Container grid class="h-full">
      {Array.from({ length: 12 }).map(() => (
        <div class="col-span-1 border-r border-line/60 h-full" />
      ))}
    </Container>
  </div>

  <Container grid class="relative py-24 md:py-36">
    <div class="col-span-12 md:col-span-8">
      <h1 class="font-display font-semibold text-4xl md:text-6xl leading-tight tracking-tight text-ink">
        SEO, GEO & AEO - done properly, never automated.
      </h1>
    </div>
    <div class="col-span-12 md:col-span-6 mt-8">
      <p class="text-lg text-ink-muted">
        A UK search visibility agency. Search isn't just Google anymore -
        people ask AI tools like ChatGPT for recommendations too, and we get
        you found in both. Every piece of content is written and structured
        properly first, because that's what search engines and AI models
        actually favour.
      </p>
      <div class="flex gap-4 mt-8">
        <Button href="/#work" variant="solid">See how we work</Button>
        <Button href="/contact-us" variant="outline">Get in touch</Button>
      </div>
    </div>
  </Container>
</section>
