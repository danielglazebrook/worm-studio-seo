---
import Container from "@/components/ui/Container.astro";

// Leave empty until real results exist - fabricated case studies would
// repeat the exact placeholder-stats problem this site already fixed once.
const caseStudies: Array<{ year: string; title: string; result: string }> = [];
---

<section id="work" class="scroll-mt-24 py-16 md:py-24 border-t border-line">
  <Container grid>
    <div class="col-span-12 md:col-span-3">
      <h2 class="font-display text-2xl font-semibold text-ink">Work</h2>
    </div>
    <div class="col-span-12 md:col-span-9">
      {
        caseStudies.length > 0 ? (
          <div class="flex flex-col">
            {caseStudies.map((cs) => (
              <div class="py-6 border-b border-line first:pt-0">
                <p class="text-xs text-ink-muted">{cs.year}</p>
                <h3 class="font-display text-lg font-medium text-ink mt-1">{cs.title}</h3>
                <p class="text-ink-muted mt-1">{cs.result}</p>
              </div>
            ))}
          </div>
        ) : (
          <p class="text-lg text-ink-muted max-w-prose">
            We're documenting our own AI-search visibility work in real time
            - first write-up coming soon. In the meantime, the fact you can
            find this page at all is the live proof.
          </p>
        )
      }
    </div>
  </Container>
</section>
