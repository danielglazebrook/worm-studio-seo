---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";

const tiers = [
  {
    name: "Visibility Audit",
    price: "£750–£1,200",
    cadence: "one-time",
    description: "For brands who want to know exactly where they stand.",
    features: ["Full technical SEO audit", "AI-search visibility check", "Structured data & schema review", "Prioritised action plan"],
  },
  {
    name: "Growth Retainer",
    price: "£900–£1,800",
    cadence: "per month",
    description: "For brands ready to actively build visibility.",
    features: ["Everything in the Audit", "Ongoing technical SEO implementation", "GEO/AEO content structuring", "Monthly visibility reporting"],
  },
  {
    name: "Full Build + Visibility",
    price: "Scoped",
    cadence: "project + retainer",
    description: "For brands building a Shopify store from the ground up, with search built in from day one.",
    features: ["Shopify design & development", "SEO/GEO/AEO integrated throughout", "Official Shopify Partner execution", "Retainer available post-launch"],
  },
];
---

<section id="pricing" class="scroll-mt-24 py-16 md:py-24 border-t border-line">
  <Container grid>
    <div class="col-span-12 md:col-span-3">
      <h2 class="font-display text-2xl font-semibold text-ink">Pricing</h2>
    </div>
    <div class="col-span-12 md:col-span-9 flex flex-col">
      {
        tiers.map((tier) => (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-x-6 py-8 border-b border-line first:pt-0">
            <div class="md:col-span-3">
              <h3 class="font-display text-xl font-medium text-ink">{tier.name}</h3>
              <p class="text-ink-muted mt-1">
                {tier.price} <span class="text-xs">{tier.cadence}</span>
              </p>
            </div>
            <div class="md:col-span-6 mt-3 md:mt-0">
              <p class="text-ink-muted">{tier.description}</p>
              <ul class="mt-3 flex flex-col gap-1.5 text-sm text-ink-muted">
                {tier.features.map((f) => (
                  <li>- {f}</li>
                ))}
              </ul>
            </div>
            <div class="md:col-span-3 mt-4 md:mt-0 md:text-right">
              <Button href="/contact-us" variant="text">Get started</Button>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
