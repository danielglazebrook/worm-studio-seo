---
import Container from "@/components/ui/Container.astro";
import Button from "@/components/ui/Button.astro";
import { packages } from "@/data/pricing";
---

<section id="pricing" class="scroll-mt-24 py-16 md:py-24 border-t border-line">
  <Container grid>
    <div class="col-span-12 md:col-span-3">
      <h2 class="font-display text-2xl font-semibold text-ink">Pricing</h2>
      <p class="text-sm text-ink-muted mt-3">
        Priced for depth, not speed. Full Shopify builds are scoped
        individually - <a href="/contact-us" class="underline decoration-gold decoration-2 underline-offset-4 hover:text-gold-deep">get in touch</a>.
      </p>
      <p class="text-sm text-ink-muted mt-3">
        <a href="/pricing" class="underline decoration-gold decoration-2 underline-offset-4 hover:text-gold-deep">Full pricing details</a>
      </p>
    </div>
    <div class="col-span-12 md:col-span-9 flex flex-col">
      {
        packages.map((pkg) => (
          <div class="grid grid-cols-1 md:grid-cols-12 gap-x-6 py-10 border-b border-line first:pt-0">
            <div class="md:col-span-3">
              <h3 class="font-display text-xl font-medium text-ink">{pkg.name}</h3>
              <p class="text-ink-muted mt-1">
                <span class="text-2xl font-display text-ink">{pkg.price}</span>
                <br />
                <span class="text-xs">{pkg.cadence}</span>
              </p>
            </div>
            <div class="md:col-span-6 mt-4 md:mt-0">
              <p class="text-ink-muted">{pkg.description}</p>
              <ul class="mt-3 flex flex-col gap-1.5 text-sm text-ink-muted">
                {pkg.features.map((f) => (
                  <li>- {f}</li>
                ))}
              </ul>
            </div>
            <div class="md:col-span-3 mt-4 md:mt-0 md:text-right">
              <Button href="/contact-us" variant="text">Get started</Button>
            </div>
          </div>
        ))
      }
    </div>
  </Container>
</section>
