---
import Container from "@/components/ui/Container.astro";
const year = new Date().getFullYear();
---

<footer class="border-t border-line mt-24">
  <Container class="py-10 flex flex-col md:flex-row justify-between gap-4 text-sm text-ink-muted">
    <p>Worm Studio Ltd - Northampton, England - {year}</p>
    <div class="flex gap-6">
      <a href="mailto:hello@wormstudio.co.uk" class="hover:text-gold-deep transition-colors">
        hello@wormstudio.co.uk
      </a>
    </div>
  </Container>
</footer>
