---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container.astro";

const allPosts = await getCollection("blog", ({ data }) => !data.draft);
const posts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title="Blog"
  description="Notes on SEO, GEO, and AEO - including our own AI-search visibility experiment, documented as it happens."
  path="/blog"
>
  <Container grid class="pt-20 pb-8">
    <h1 class="col-span-12 font-display text-4xl md:text-5xl font-semibold text-ink">Blog</h1>
  </Container>

  <Container grid class="py-12">
    <div class="col-span-12 md:col-span-9 md:col-start-4">
      {
        posts.length > 0 ? (
          <div class="flex flex-col">
            {posts.map((post) => (
              <a href={`/blog/${post.slug}`} class="group grid grid-cols-12 gap-x-6 py-8 border-b border-line first:pt-0">
                <p class="col-span-3 text-xs text-ink-muted">
                  {post.data.pubDate.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" })}
                </p>
                <h2 class="col-span-9 font-display text-2xl font-medium text-ink group-hover:text-gold-deep transition-colors">
                  {post.data.title}
                </h2>
                <p class="col-span-9 col-start-4 text-ink-muted mt-2">{post.data.description}</p>
              </a>
            ))}
          </div>
        ) : (
          <p class="text-lg text-ink-muted">First post coming soon.</p>
        )
      }
    </div>
  </Container>
</Layout>
