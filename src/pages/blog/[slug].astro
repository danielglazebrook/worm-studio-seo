---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: CollectionEntry<"blog"> }
const { post } = Astro.props;
const { Content } = await post.render();
const SITE_URL = "https://wormstudio.co.uk";

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { "@type": "Organization", name: "Worm Studio" },
  publisher: { "@type": "Organization", name: "Worm Studio", url: SITE_URL },
  mainEntityOfPage: `${SITE_URL}/blog/${post.slug}`,
};
---

<Layout title={post.data.title} description={post.data.description} path={`/blog/${post.slug}`} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />

  <Container grid class="pt-20 pb-8">
    <div class="col-span-12 md:col-span-8 md:col-start-3">
      <p class="text-xs text-ink-muted uppercase tracking-wide">
        {post.data.pubDate.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" })} · {post.data.category}
      </p>
      <h1 class="font-display text-3xl md:text-5xl font-semibold text-ink mt-3 leading-tight">
        {post.data.title}
      </h1>
    </div>
  </Container>

  <Container grid class="py-12">
    <div class="col-span-12 md:col-span-8 md:col-start-3 prose prose-neutral max-w-none prose-headings:font-display prose-headings:font-semibold prose-a:text-gold-deep">
      <Content />
    </div>
  </Container>
</Layout>
