---
import Layout from "@/layouts/Layout.astro";
import Container from "@/components/ui/Container.astro";
---

<Layout
  title="Contact"
  description="Get in touch with Worm Studio about SEO, GEO, or AEO for your brand."
  path="/contact-us"
>
  <Container grid class="pt-20 pb-24">
    <div class="col-span-12 md:col-span-8">
      <h1 class="font-display text-4xl md:text-5xl font-semibold text-ink leading-tight">
        Let's get you found - everywhere search happens.
      </h1>
    </div>
    <div class="col-span-12 md:col-span-6 mt-8">
      <p class="text-lg text-ink-muted">
        Whether you're an established brand losing visibility to AI search,
        or starting fresh and want search built in from day one - we'd love
        to hear about it.
      </p>
      <a href="mailto:hello@wormstudio.co.uk" class="inline-block mt-6 text-xl font-display text-gold-deep underline decoration-2 underline-offset-4">
        hello@wormstudio.co.uk
      </a>
    </div>
  </Container>
</Layout>
